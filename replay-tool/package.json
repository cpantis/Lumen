{
  "name": "lumen-replay",
  "private": true,
  "version": "1.0.0",
  "description": ".lumen Replay — replay sincronizat pentru înregistrări ROS 2 MCAP ale Ochelarilor .lumen",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "gen:synthetic": "tsx scripts/gen-synthetic.ts",
    "inspect": "tsx scripts/inspect.ts",
    "metrics": "tsx scripts/metrics-cli.ts"
  },
  "dependencies": {
    "@foxglove/ros2idl-parser": "0.3.5",
    "@foxglove/rosmsg": "5.0.5",
    "@foxglove/rosmsg2-serialization": "3.1.2",
    "@mcap/core": "2.4.0",
    "fzstd": "0.1.1",
    "html-to-image": "1.11.13",
    "js-yaml": "4.1.0",
    "jszip": "3.10.1",
    "lucide-react": "0.468.0",
    "lz4js": "0.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "1.5.2",
    "three": "0.170.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.63.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.10.7",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/react-grid-layout": "1.3.5",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "3.0.5"
  }
}
